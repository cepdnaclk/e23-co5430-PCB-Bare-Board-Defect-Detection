# PyTorch / Ultralytics (YOLO)
# Ignore trained model weights (large binary files)
*.pt
*.pth
# Ignore training artifact images and CSVs (auto-generated by YOLO training)
runs/**/*.jpg
runs/**/*.png
runs/**/*.csv
# But keep the runs/ directory structure itself tracked
!runs/**/.gitkeep

# Project Specific Directories
# Ignore generated outputs but keep the placeholder so the directory exists on fresh clone
outputs/ablation*
outputs/classical_topological/
outputs/dl/
!outputs/.gitkeep
temp/
demo_ui/temp/
agent/
ui_results

